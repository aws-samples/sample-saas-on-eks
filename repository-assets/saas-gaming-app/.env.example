# AWS Configuration
AWS_REGION=us-east-1

# S3 Configuration
S3_BUCKET=your-bucket-name

# DynamoDB Configuration
# For Basic tier: uses shared table (gaming-app-shared)
# For Pro tier: uses dedicated table (gaming-app-tenant-{TENANT_ID})
DYNAMODB_TABLE=your-table-name

# Tenant Configuration (REQUIRED)
# Unique identifier for the tenant organization
TENANT_ID=acme-corp-001

# Display name for the tenant organization
TENANT_NAME=Acme Corporation

# Tenant subscription tier: 'basic' or 'pro'
# - basic: Uses shared DynamoDB table with tenant isolation via partition keys
# - pro: Uses dedicated DynamoDB table for better performance and isolation
TENANT_TIER=basic

# Application Configuration
PORT=8080
NODE_ENV=development

# AWS Credentials (for local development only)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
